TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-default-chat-id
TELEGRAM_WEBHOOK_SECRET=optional-random-secret-token

OPENROUTER_API_KEY=your-openrouter-api-key
# Llama 3.1 70B is the paid primary; charges may apply when it answers.
OPENROUTER_MODELS=meta-llama/llama-3.1-70b-instruct,nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free,apodex/apodex-1.1-mini:free
OPENROUTER_TIMEOUT=25
# Free models that accept image input, for photos sent to the bot.
OPENROUTER_VISION_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free
# Gates the detailed /health diagnostics (quota, credit, key label).
# Without it /health returns booleans only, since the endpoint is public.
HEALTH_TOKEN=generate-a-random-string
PORT=8000

# Storage. Leave DATABASE_URL empty to use the local SQLite file; set it to a
# Supabase/Postgres connection string to use Postgres. DB_SCHEMA keeps this app's
# tables away from any other product sharing the database.
DATABASE_URL=
DB_SCHEMA=tri_buddy
# Seconds. Bounds a bad DATABASE_URL so /health cannot hang.
DB_CONNECT_TIMEOUT=5
