# Choose one: 'serpapi' or 'tavily'
HERMES_SEARCH_PROVIDER=serpapi

# SerpApi API key (get from https://serpapi.com)
# Sign up for free at https://serpapi.com/users/sign_up
SERPAPI_API_KEY=87345171a1f1b4462e88035e5a5f258521ef16b8

# Tavily API key (get from https://app.tavily.com)
# Tavily is free for research purposes
TAVILY_API_KEY=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

# System Monitor Configuration
HERMES_LOG_LEVEL=INFO
HERMES_LOG_FILE=hermes.log

