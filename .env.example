# Template only -- placeholders, never real values. This file is NOT gitignored,
# so anything written here is committed. Copy it to .env (which is ignored, and
# the only env file load_dotenv reads) and fill that in instead.

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=1-256-chars-of-letters-numbers-underscores-hyphens
# A numeric chat id, not a bot username. Not needed for webhook replies -- the bot
# answers whichever chat sent the update. Only POST /message uses it.
TELEGRAM_CHAT_ID=your-default-chat-id

OPENROUTER_API_KEY=your-openrouter-api-key
# API base. Only set this to point at a proxy or a local stub.
# OPENROUTER_URL=https://openrouter.ai/api/v1
# FALLBACKS only, in order, as exact OpenRouter model ids. The primary --
# meta-llama/llama-3.1-70b-instruct -- is pinned in app/services/models.py and always
# answers first; nothing here can displace it, and listing it is redundant. It is paid,
# so charges may apply on every message. A name like "llama 3.1 70b" is not an id and
# will 404 on every request.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# Adds one free model as the FIRST fallback, after the primary. Ignored unless it is a
# ":free" model, so an unreviewed paid model cannot join the chain by accident.
# OPENROUTER_MODEL=
# Free models that accept image input, for photos sent to the bot.
OPENROUTER_VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,openrouter/free
# Per-attempt timeout, then the ceiling for the whole fallback chain. The chain must
# finish well inside the gunicorn --timeout, because a killed worker sends no reply.
OPENROUTER_TIMEOUT=25
OPENROUTER_BUDGET=45

# The webhook answers Telegram immediately and replies from a background worker.
# WEBHOOK_WORKERS caps how many updates are processed at once; past
# WEBHOOK_MAX_PENDING queued updates the sender is told to retry instead.
WEBHOOK_WORKERS=4
WEBHOOK_MAX_PENDING=32

# Gates the detailed /health diagnostics (quota, credit, key label).
# Without it /health returns booleans only, since the endpoint is public.
HEALTH_TOKEN=generate-a-random-string
PORT=8000

# Storage. Leave DATABASE_URL empty to use the local SQLite file; set it to a
# Supabase/Postgres connection string to use Postgres. DB_SCHEMA keeps this app's
# tables away from any other product sharing the database.
# The name is case-sensitive: "Database_URL" is not read, and the app then falls
# back to SQLite on an ephemeral disk, losing data on every deploy.
# Use the session pooler or a direct connection (port 5432), not the transaction
# pooler (6543) -- see the Storage section of the README.
DATABASE_URL=
DB_SCHEMA=tri_buddy
# Seconds. Bounds a bad DATABASE_URL so /health cannot hang.
DB_CONNECT_TIMEOUT=5
